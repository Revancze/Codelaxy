{
  "$comment": "Python stdlib validator adds cross-record, pinned-byte, artifact and Git-baseline checks. DEC is not a stored entity.",
  "$defs": {
    "acceptance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "decision",
            "evidence",
            "requirement"
          ]
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "resolved": {
          "type": "boolean"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "resolved",
        "text"
      ],
      "type": "object"
    },
    "aliases": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_with": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "namespace": {
          "minLength": 1,
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "type": "string"
        },
        "range_source": {
          "$ref": "#/$defs/source_ref"
        },
        "source": {
          "$ref": "#/$defs/source_ref"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "AMBIGUOUS",
            "HISTORICAL",
            "IMPLIED_BY_RANGE",
            "REJECTED"
          ]
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "source",
        "status",
        "value"
      ],
      "type": "object"
    },
    "applies_to": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "minLength": 1,
          "type": "string"
        },
        "platforms": {
          "items": {
            "enum": [
              "any",
              "linux",
              "macos",
              "windows"
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "platforms"
      ],
      "type": "object"
    },
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "role",
        "sha256"
      ],
      "type": "object"
    },
    "asserted_status": {
