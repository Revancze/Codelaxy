root = true

# ==============================================================================
# Codelaxy formatting contract
# Line endings must agree with .gitattributes.
# ==============================================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# ------------------------------------------------------------------------------
# Solution files: Visual Studio expects CRLF and tabs (.gitattributes: eol=crlf)
# ------------------------------------------------------------------------------

[*.sln]
end_of_line = crlf
indent_style = tab

# ------------------------------------------------------------------------------
# MSBuild, XML, JSON, YAML
# ------------------------------------------------------------------------------

[*.{csproj,props,targets,xml,config,nuspec,resx}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# ------------------------------------------------------------------------------
# Markdown: two trailing spaces are a meaningful line break
# ------------------------------------------------------------------------------

[*.md]
trim_trailing_whitespace = false

# ------------------------------------------------------------------------------
# Shell
# ------------------------------------------------------------------------------

[*.sh]
indent_size = 4

# ------------------------------------------------------------------------------
# C#
# ------------------------------------------------------------------------------

[*.{cs,csx}]

# Braces / new lines: Allman style
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Spacing
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_before_colon_in_inheritance_clause = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false

# Wrapping: keep intentional single-line blocks, never join statements
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Code style already used across the repository
csharp_style_namespace_declarations = file_scoped:warning

# CSharpier owns C# layout.
dotnet_diagnostic.IDE0055.severity = none

# ============================================================
#  Úklid a styl (IDE*). Závažnosti CA/S/MA/RCS jsou v .globalconfig.
# ============================================================
# nepoužité usingy
dotnet_diagnostic.IDE0005.severity = warning
# nepoužitý privátní člen
dotnet_diagnostic.IDE0051.severity = warning
# nepřečtený privátní člen
dotnet_diagnostic.IDE0052.severity = warning
# zbytečné přiřazení
dotnet_diagnostic.IDE0059.severity = warning
# nepoužitý parametr
dotnet_diagnostic.IDE0060.severity = warning
# file-scoped namespace
dotnet_diagnostic.IDE0161.severity = warning
# explicitní modifikátory přístupu
dotnet_diagnostic.IDE0040.severity = warning
# readonly pole
dotnet_diagnostic.IDE0044.severity = warning
# zbytečné přetypování
dotnet_diagnostic.IDE0004.severity = warning
# auto-vlastnost místo ručního backing pole
dotnet_diagnostic.IDE0032.severity = warning
# nedosažitelný kód
dotnet_diagnostic.IDE0035.severity = warning
# pořadí modifikátorů
dotnet_diagnostic.IDE0036.severity = warning
# GetHashCode přes System.HashCode
dotnet_diagnostic.IDE0070.severity = warning
# zbytečně složitá podmínka
dotnet_diagnostic.IDE0075.severity = warning
# zbytečný operátor potlačení
dotnet_diagnostic.IDE0080.severity = warning
# == true / == false
dotnet_diagnostic.IDE0100.severity = warning
# zbytečný discard
dotnet_diagnostic.IDE0110.severity = warning
# namespace odpovídá složce
dotnet_diagnostic.IDE0130.severity = warning
# struct může být readonly
dotnet_diagnostic.IDE0250.severity = warning
# člen structu může být readonly
dotnet_diagnostic.IDE0251.severity = warning
# nameof místo literálu
dotnet_diagnostic.IDE0280.severity = warning

# Vždy složené závorky u if/else/for/... (chrání před chybami typu „goto fail“).
# CSharpier závorky nepřidává ani neodebírá, s formátováním se to nebije.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# ============================================================
#  Pojmenování
#  IDE1006 musí mít závažnost, jinak se naming rules v buildu nehlásí.
# ============================================================
dotnet_diagnostic.IDE1006.severity = warning

# Rozhraní: IJmeno hlídá CA1715 v .globalconfig (navíc i prefix T u generik).

# Typy a veřejné členy: PascalCase
dotnet_naming_rule.types_pascal.symbols = type_symbols
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# Async metody: ...Async
dotnet_naming_rule.async_suffix.symbols = async_methods
dotnet_naming_rule.async_suffix.style = async_style
dotnet_naming_rule.async_suffix.severity = warning
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_style.required_suffix = Async
dotnet_naming_style.async_style.capitalization = pascal_case

# Privátní static readonly pole: PascalCase (konvence repa)
dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly.style = pascal
dotnet_naming_rule.private_static_readonly.severity = warning
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

# Privátní pole: _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Konstanty: PascalCase
dotnet_naming_rule.constants.symbols = const_fields
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.required_modifiers = const

# ============================================================
#  Testy – povolit, co je v testech normální
#  (celé tests/, tedy i Codelaxy.ProcessTestHelper)
# ============================================================
[tests/**.cs]
# podtržítka v názvech testů
dotnet_diagnostic.CA1707.severity = none
# xUnit konvence ...Collection
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1506.severity = suggestion
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.CA1822.severity = none
# Assert.* bez StringComparison
dotnet_diagnostic.CA1307.severity = suggestion
# comparer v testovacích kolekcích
dotnet_diagnostic.MA0002.severity = suggestion
# regexy nad konstantním testovacím vstupem
dotnet_diagnostic.MA0009.severity = suggestion
# arrange/act/assert bývá dlouhé
dotnet_diagnostic.MA0051.severity = suggestion
# testy smí stavět fixtures třeba přes Encoding.UTF8
dotnet_diagnostic.RS0030.severity = suggestion
dotnet_naming_rule.async_suffix.severity = none
